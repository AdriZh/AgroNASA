{
  "name": "field-shift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Field Shift — budget-aware, NASA-informed crop-rotation planner (NASA Space Apps 2026)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "data": "vite-node scripts/build-demo-data.ts data/raw",
    "demo:print": "vite-node scripts/print-demo-results.ts",
    "video:frames": "node scripts/render-video.cjs http://localhost:4173/ .video/frames 30",
    "video:audio": "python3 scripts/make-soundtrack.py src/ui/video/timing.json .video/tts .video/mix.wav",
    "video:encode": "bash scripts/encode-video.sh .video/frames .video/mix.wav public/media"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12"
  }
}
